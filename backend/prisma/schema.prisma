generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  passwordHash    String
  role            Role            @default(STUDENT)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  approvalStatus  ApprovalStatus  @default(APPROVED)
  rejectionReason String?
  profile         StudentProfile?
}

model StudentProfile {
  id                String               @id @default(cuid())
  userId            String               @unique
  firstName         String
  lastName          String
  studentId         String               @unique
  department        String
  year              Int
  phone             String?
  gender            String
  profileComplete   Boolean              @default(false)
  avatarUrl         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  compatibilityA    CompatibilityScore[] @relation("StudentA")
  compatibilityB    CompatibilityScore[] @relation("StudentB")
  conflictsReceived Conflict[]           @relation("Reported")
  conflictsReported Conflict[]           @relation("Reporter")
  feedbacks         Feedback[]
  preference        Preference?
  allocations       RoomAllocation[]
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preference {
  id                       String         @id @default(cuid())
  studentProfileId         String         @unique
  sleepTime                String
  wakeTime                 String
  weekendSleepTime         String
  weekendWakeTime          String
  lifestyleType            Int
  exerciseHabits           Int
  studyHoursPerDay         Int
  studiesInRoom            Boolean
  studyEnvironment         Int
  noiseWhileStudy          Int
  examIntensity            Int
  cleanlinessLevel         Int
  organizationLevel        Int
  bathroomCleanliness      Int
  garbageDisposal          Int
  sharedSpaceCleanliness   Int
  noiseTolerance           Int
  musicFrequency           Int
  gamingFrequency          Int
  callsFrequency           Int
  mediaFrequency           Int
  socialLevel              Int
  preferredInteraction     Int
  visitorFrequency         Int
  friendsInRoom            Int
  socialRoommatePreference Int
  privacyImportance        Int
  personalSpaceNeed        Int
  sharingComfort           Int
  visitorComfort           Int
  boundaryStrictness       Int
  hobbies                  String[]       @default([])
  isComplete               Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  studentProfile           StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model Room {
  id          String           @id @default(cuid())
  number      String           @unique
  capacity    Int
  gender      String
  floor       Int?
  building    String?
  description String?
  status      RoomStatus       @default(AVAILABLE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  allocations RoomAllocation[]
}

model RoomAllocation {
  id               String           @id @default(cuid())
  roomId           String
  studentProfileId String
  matchingRunId    String?
  status           AllocationStatus @default(PENDING)
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  feedbacks        Feedback[]
  matchingRun      MatchingRun?     @relation(fields: [matchingRunId], references: [id])
  room             Room             @relation(fields: [roomId], references: [id])
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id])

  @@unique([roomId, studentProfileId])
}

model CompatibilityScore {
  id               String         @id @default(cuid())
  studentAId       String
  studentBId       String
  score            Float
  lifestyleScore   Float?
  studyScore       Float?
  cleanlinessScore Float?
  socialScore      Float?
  boundaryScore    Float?
  matchingRunId    String?
  createdAt        DateTime       @default(now())
  matchingRun      MatchingRun?   @relation(fields: [matchingRunId], references: [id])
  studentA         StudentProfile @relation("StudentA", fields: [studentAId], references: [id])
  studentB         StudentProfile @relation("StudentB", fields: [studentBId], references: [id])

  @@unique([studentAId, studentBId, matchingRunId])
}

model MatchingRun {
  id                  String               @id @default(cuid())
  status              MatchingRunStatus    @default(RUNNING)
  totalStudents       Int                  @default(0)
  totalRooms          Int                  @default(0)
  studentsAssigned    Int                  @default(0)
  studentsUnassigned  Int                  @default(0)
  avgCompatibility    Float?
  algorithmVersion    String               @default("1.0.0")
  notes               String?
  runDurationMs       Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  compatibilityScores CompatibilityScore[]
  allocations         RoomAllocation[]
}

model Feedback {
  id                     String         @id @default(cuid())
  studentProfileId       String
  roomAllocationId       String
  overallSatisfaction    Int
  cleanlinessScore       Int
  studyCompatibility     Int
  lifestyleCompatibility Int
  noiseCompatibility     Int
  wouldChooseAgain       Boolean
  conflictExperienced    Boolean
  comment                String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  roomAllocation         RoomAllocation @relation(fields: [roomAllocationId], references: [id], onDelete: Cascade)
  studentProfile         StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

model Conflict {
  id                String         @id @default(cuid())
  reporterProfileId String
  reportedProfileId String
  reason            String
  status            ConflictStatus @default(REPORTED)
  adminNotes        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  reported          StudentProfile @relation("Reported", fields: [reportedProfileId], references: [id])
  reporter          StudentProfile @relation("Reporter", fields: [reporterProfileId], references: [id])
}

model SystemSettings {
  id                    String    @id @default("singleton")
  questionnaireDeadline DateTime?
  questionnaireOpen     Boolean   @default(true)
  updatedAt             DateTime  @updatedAt
}

model OtpVerification {
  id         String   @id @default(cuid())
  email      String   @unique
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false)
  lastSentAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  STUDENT
  ADMIN
  MANAGEMENT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum AllocationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum MatchingRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ConflictStatus {
  REPORTED
  RESOLVED
  DISMISSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
