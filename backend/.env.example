# =================================================================
# HOSTELSYNC BACKEND ENVIRONMENT CONFIGURATION
# =================================================================

# 1. Database Connection (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostelsync?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hostelsync?schema=public"

# 2. JWT Authentication Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# 3. Server & CORS
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# 4. Email OTP Verification Configuration (Gmail SMTP)
# To send real 6-digit verification codes to user inboxes:
# 1. Go to your Google Account -> Security -> 2-Step Verification
# 2. Scroll to the bottom and select "App passwords" (https://myaccount.google.com/apppasswords)
# 3. Create an App password named "HostelSync"
# 4. Copy the generated 16-character password into EMAIL_PASSWORD below:
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional: Custom From Display Name/Address
EMAIL_FROM="HostelSync <no-reply@hostelsync.com>"

# Optional Alternative: Custom SMTP Server (SendGrid / Brevo / Mailtrap / AWS SES)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
